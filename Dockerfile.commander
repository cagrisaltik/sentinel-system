# --- Aşama 1: İnşaat (Builder) ---
FROM golang:alpine AS builder

WORKDIR /app

# Git yükle (Kütüphaneler için şart)
RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Analyst'i derle
RUN go build -o analyst cmd/analyst/main.go

# --- Aşama 2: Çalıştırma (Runner) ---
FROM alpine:latest

WORKDIR /root/

# 1. Uygulamanın kendisini Builder'dan al
COPY --from=builder /app/analyst .

# 2. KRİTİK DÜZELTME (Commander ile aynı yapıldı)
# Web klasörünü direkt bilgisayarındaki kaynak koddan alıyoruz
COPY web ./web

# Port ve Çalıştırma
EXPOSE 3000
CMD ["./analyst"]