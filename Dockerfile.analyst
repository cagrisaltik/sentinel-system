FROM golang:1.23-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o analyst cmd/analyst/main.go

FROM alpine:latest
WORKDIR /root/
# Web arayüzü dosyalarını kopyalamayı unutma!
COPY --from=builder /app/web ./web 
COPY --from=builder /app/analyst .
CMD ["./analyst"]