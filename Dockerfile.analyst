FROM golang:1.25.1-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY cmd/analyst ./cmd/analyst
COPY web/analyst ./web/analyst
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/analyst ./cmd/analyst

FROM alpine:latest

RUN apk add --no-cache ca-certificates \
    && addgroup -S analyst \
    && adduser -S -G analyst analyst
WORKDIR /app
COPY --from=builder --chown=analyst:analyst /out/analyst ./analyst
COPY --from=builder --chown=analyst:analyst /src/web/analyst ./web/analyst

USER analyst:analyst
EXPOSE 3000
ENTRYPOINT ["./analyst"]
