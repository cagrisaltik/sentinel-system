FROM golang:alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Analyst paketini derle
RUN go build -o analyst ./cmd/analyst/main.go

FROM alpine:latest
WORKDIR /root/
COPY --from=builder /app/analyst .
# Web klasörünü de kopyala (önemli!)
COPY --from=builder /app/web ./web

CMD ["./analyst"]