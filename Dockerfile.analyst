FROM golang:alpine AS builder

WORKDIR /app

# 1. KRİTİK DÜZELTME: Git'i yüklüyoruz. 
# Go modüllerini indirmek için Git gereklidir, Alpine'de yüklü gelmez.
RUN apk add --no-cache git

# 2. Modül dosyalarını kopyala
COPY go.mod go.sum ./

# 3. Bağımlılıkları indir (Artık hata vermez)
RUN go mod download

# 4. Kaynak kodları kopyala ve derle
COPY . .
RUN go build -o analyst cmd/analyst/main.go

# --- Final Sahnesi ---
FROM alpine:latest
WORKDIR /root/
COPY --from=builder /app/web ./web 
COPY --from=builder /app/analyst .
CMD ["./analyst"]